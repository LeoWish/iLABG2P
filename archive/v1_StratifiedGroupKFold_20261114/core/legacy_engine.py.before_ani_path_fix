        if args.mode=='quick':A=A[:args.quick_combos];B=B[:args.quick_combos]
        atomic_json(out/'00_Protocol.json',{'version':VERSION,'config':vars(args),'encoders':list(lm),
            'classifier_configs':ready,'fusion_methods':MIDDLES,'A_upstreams':len(A),
            'B_upstreams':len(B),'ANI_method':method,
            'validation':'Each model is trained from scratch in 5 group-disjoint outer folds',
            'feature_transform':'TRAIN-only correlation selection, train-only scaler or normalizer',
            'threshold':.5,'score':'0.6*PR_AUC+0.4*MCC','kmer_sketch':'canonical hashed; 16x1024bp sampled windows by default',
            'external_test':False,'feature_protocol_digest':FEATURE_PROTOCOL_DIGEST})
        results=[];failures=[];mid=MIDDLES if args.mode!='quick' else ('block128_z',)
        clfs=ready if args.mode!='quick' else ready[:2]
        for task in ('acid','bile'):
            jobs=[(task,'A_ENCODER',up,m,c) for up in A for m in mid for c in clfs]
            jobs +=[(task,'B_KMER',up,m,c) for up in B for m in mid for c in clfs]
            run_jobs(jobs,records,folds,features,groups,meta,out,args,results,failures)
        # Cross-route Top5 candidates from their respective SAME-COHORT completed OOF files.
        if A and B and args.mode not in ('quick','encoder','kmer'):
            provisional=[]
            for x in results:
                try:
                    idx,_=folds[x['task']]
                    with np.load(x['path'],allow_pickle=False) as z:
                        p=z['score'];q=z['pred']
                    y=np.array([records[i][x['task']] for i in idx],dtype=int)
                    z=metrics(y,p[idx],q[idx]);provisional.append(dict(x,**z))
                except Exception as e:failures.append({'job':'RANK '+str(x.get('id')),'reason':repr(e),'traceback':''})
            for task in ('acid','bile'):
                left=sorted([x for x in provisional if x['task']==task and x['route']=='A_ENCODER'],
                            key=lambda x:-x['Selection_Score'])[:5]
                right=sorted([x for x in provisional if x['task']==task and x['route']=='B_KMER'],
                             key=lambda x:-x['Selection_Score'])[:5]
                cross=list(dict.fromkeys(tuple(dict.fromkeys(a['up']+b['up'])) for a in left for b in right))
                jobs=[(task,'C_CROSS',up,m,c) for up in cross for m in ('block128_z','block256_z') for c in ready]
                run_jobs(jobs,records,folds,features,groups,meta,out,args,results,failures)
        write_csv(out/'99_Model_Failures.csv',failures,['job','reason','traceback'])
        results=merge_verified_existing(results,out,meta)
        package_results(results,records,folds,groups,meta,out,missing,av,failures)
        log('[FINISHED] New 256 OOF archive:',out,'failed configs:',len(failures))
    except Exception:
        (out/'99_FATAL_ERROR.txt').write_text(traceback.format_exc(),encoding='utf-8')
        log('[FATAL]',traceback.format_exc());raise

