def log(*args):
    print('['+datetime.now().strftime('%Y-%m-%d %H:%M:%S')+']',*args,flush=True)

def sha(p):
    h=hashlib.sha256()
    with open(p,'rb') as f:
        for b in iter(lambda:f.read(1<<20),b''):
            h.update(b)
    return h.hexdigest()

def digest(x):
    return hashlib.sha256(json.dumps(x,sort_keys=True,ensure_ascii=False,default=str).encode()).hexdigest()

def atomic_json(p,data):
    p=Path(p);p.parent.mkdir(parents=True,exist_ok=True)
    tmp=p.with_suffix(p.suffix+'.tmp')
    tmp.write_text(json.dumps(data,indent=2,ensure_ascii=False,default=str,allow_nan=False),encoding='utf-8')
    os.replace(tmp,p)

def write_csv(p,rows,fields):
    p=Path(p);p.parent.mkdir(parents=True,exist_ok=True)
    tmp=p.with_suffix(p.suffix+'.tmp')
    with tmp.open('w',newline='',encoding='utf-8-sig') as f:
        w=csv.DictWriter(f,fieldnames=fields,extrasaction='ignore');w.writeheader();w.writerows(rows)
    os.replace(tmp,p)

def norm(x):return re.sub('[^a-z0-9]','',str(x).lower())

def fasta_stem(p):
    name=p.name
    for s in EXTS:
        if name.lower().endswith(s):
            name=name[:-len(s)];break
    else:return None
    while True:
        orig=name
        for s in ID_TAILS:
            if name.lower().endswith(s):name=name[:-len(s)]
        if name==orig:break
    return name

def valid_label(s):
    v=str(s).strip()
    if v in ('','?','nan','NaN','NA','None','null'):return None
    if v in ('0','0.0'):return 0
    if v in ('1','1.0'):return 1
    raise ValueError('Label must be 0,1 or ?: '+repr(v))

def audit_cohort(root,out):
    csv_path=root/'data'/'data_256.csv';gdir=root/'data'/'genome'
    if not csv_path.is_file():raise RuntimeError('MISSING canonical label file: '+str(csv_path))
    if not gdir.is_dir():raise RuntimeError('MISSING genome directory: '+str(gdir))
    with csv_path.open(newline='',encoding='utf-8-sig') as f:rows=list(csv.DictReader(f))
    required=['Strain_ID','Species','Acid Resistant','Bile Resistant']
    if len(rows)!=256:raise RuntimeError('Expected 256 CSV rows, got '+str(len(rows)))
    if any(k not in rows[0] for k in required):raise RuntimeError('CSV columns must include '+str(required))
    ids=[x['Strain_ID'].strip() for x in rows]
    if len(set(ids))!=256 or not all(ids) or len(set(map(norm,ids)))!=256:
        raise RuntimeError('Duplicate or empty Strain_ID')
    if norm('Probio-M8') in set(map(norm,ids)) or 'M8' not in ids:
        raise RuntimeError('Identity policy violation: delete Probio-M8 and keep M8')
    files=[p for p in gdir.rglob('*') if p.is_file() and fasta_stem(p) is not None]
    if len(files)!=256:
        csv_norm={norm(i) for i in ids}
        genome_norm={norm(fasta_stem(p)) for p in files}
        only_genomes=sorted(fasta_stem(p) for p in files if norm(fasta_stem(p)) not in csv_norm)
        only_csv=sorted(i for i in ids if norm(i) not in genome_norm)
        raise RuntimeError(
            f'COHORT_MISMATCH: data_256.csv has 256 rows but genome has {len(files)} FASTA files. '
            f'Genome-only IDs: {only_genomes[:30]}; CSV-only IDs: {only_csv[:30]}. '
            'Do not delete files automatically; reconcile the canonical 256 genomes first.'
        )
    byname=defaultdict(list)
    for p in files:byname[norm(fasta_stem(p))].append(p)
    missing=[i for i in ids if len(byname[norm(i)])!=1]
    if missing:raise RuntimeError('FASTA identity 1:1 mismatch: '+repr(missing[:20]))
    used=set();records=[]
    for r in rows:
        rid=r['Strain_ID'].strip();p=byname[norm(rid)][0]
        if p in used:raise RuntimeError('FASTA reused by multiple IDs')
        used.add(p)
        records.append({'id':rid,'species':r['Species'].strip() or 'UNKNOWN',
                        'acid':valid_label(r['Acid Resistant']),
                        'bile':valid_label(r['Bile Resistant']),
                        'fasta':str(p.resolve()),'genome_sha':sha(p),
                        'genome_size':p.stat().st_size,'genome_mtime_ns':p.stat().st_mtime_ns})
    if len(used)!=len(files):raise RuntimeError('Unmapped FASTA files')
    namehash={}
    for r in records:
        if r['genome_sha'] in namehash:
            log('[ALERT] Identical genome file content:',namehash[r['genome_sha']],r['id'])
        namehash[r['genome_sha']]=r['id']
    meta={'version':VERSION,'rows':256,'genomes':len(files),'label_csv':str(csv_path),
          'label_csv_sha256':sha(csv_path),'acid':dict(Counter(str(r['acid']) for r in records)),
          'bile':dict(Counter(str(r['bile']) for r in records)),
          'cohort_digest':digest([(r['id'],r['species'],r['acid'],r['bile'],r['genome_sha']) for r in records]),
          'genome_digest':digest([(r['id'],r['genome_sha']) for r in records]),
          'id_policy':'M8 kept; Probio-M8 excluded','tag':'FROZEN_256'}
    write_csv(out/'00_Cohort_256_Manifest.csv',records,list(records[0]))
    atomic_json(out/'00_Cohort_256_Audit.json',meta)
    log('[COHORT PASS] 256/256',meta['acid'],meta['bile'])
    return records,meta

class DSU:
    def __init__(self,n):self.p=list(range(n))
    def root(self,x):
        while self.p[x]!=x:
            self.p[x]=self.p[self.p[x]];x=self.p[x]
        return x
    def join(self,a,b):
        a=self.root(a);b=self.root(b)
        if a!=b:self.p[max(a,b)]=min(a,b)

def ani_groups(records,out,args):
    index={r['id']:i for i,r in enumerate(records)}
    lookup={norm(r['id']):r['id'] for r in records}
    for r in records:
        p=Path(r['fasta'])
        lookup[norm(str(p))]=r['id'];lookup[norm(p.name)]=r['id']
        lookup[norm(fasta_stem(p))]=r['id']
    uf=DSU(len(records));dup={}
    for i,r in enumerate(records):
        if r['genome_sha'] in dup:uf.join(i,dup[r['genome_sha']])
        else:dup[r['genome_sha']]=i
    path=out/'00_ANI995_skani_edges.tsv';method='skani_triangle_sparse_ANI_ge_99.5'
    current_input=digest([(r['id'],r['genome_sha']) for r in records])
    old_lock=out/'00_ANI_Input_Lock.json'
    old_ani_lock=json.loads(old_lock.read_text()) if old_lock.exists() else {}
    past_input=old_ani_lock.get('digest')
    tampered=path.exists() and old_ani_lock.get('skani_result_sha256')!=sha(path)
    if args.ani_groups:
        z=pd.read_csv(args.ani_groups,dtype=str).fillna('')
        idcol=next((x for x in z if norm(x) in ('strainid','strain','id')),None)
        grcol=next((x for x in z if norm(x) in ('ani995group','anigroup','anicluster','groupid','cluster')),None)
        if not idcol or not grcol or len(z)!=256 or z[idcol].duplicated().any():
            raise RuntimeError('ANI group CSV must map exactly 256 unique Strain_ID to clusters')
        groups=dict(zip(z[idcol],z[grcol]))
        if set(groups)!=set(index) or not all(groups.values()):
            raise RuntimeError('Missing IDs in ANI group CSV')
        for i,r in enumerate(records):
            if groups[r['id']]!=groups[records[uf.root(i)]['id']]:
                raise RuntimeError('ANI grouping splits exact file-duplicates')
        method='provided_ANI995_groups_NOT independently recomputed'
        keys=[groups[r['id']] for r in records]
    else:
        if not path.exists() or args.recompute_ani or past_input!=current_input or tampered:
            if not shutil.which('skani'):
                if not args.allow_species_fallback:
                    raise RuntimeError('skani not installed and no --ani-groups CSV. Refuse to label folds ANI-safe.')
                log('[WARN] skani absent; using SPECIES CONSERVATIVE folds (NOT ANI995)')
                keys=[r['species'] for r in records]
                if any(x=='UNKNOWN' for x in keys):raise RuntimeError('Species fallback has UNKNOWN species')
                method='SPECIES_CONSERVATIVE_NOT_ANI995'
                return keys,method,{'group_count':len(set(keys)),'method':method,'skani_sha256':None}
            gl=out/'00_Genome_List.txt';gl.write_text('\n'.join(r['fasta'] for r in records)+'\n')
            cmd=['skani','triangle','-l',str(gl),'-o',str(path),'--sparse','-t',str(max(1,args.threads))]
            log('[ANI]',' '.join(cmd));z=subprocess.run(cmd,text=True,capture_output=True)
            (out/'00_Skani_Run.log').write_text(z.stdout+'\n'+z.stderr,encoding='utf-8')
            if z.returncode!=0 or not path.exists():
                raise RuntimeError('skani failed; see 00_Skani_Run.log')
        # A sparse skani edge list is a standard TSV with ref,query,ANI (other columns optional).
        with path.open(encoding='utf-8') as f:
            rows=list(csv.reader(f,delimiter='\t'))
        if not rows:raise RuntimeError('Empty skani ANI file')
        h=[norm(x) for x in rows[0]]
        if not any(x in h for x in ('ani','identity')):
            raise RuntimeError('Unexpected skani edge list header: '+repr(rows[0]))
        ai=next(i for i,x in enumerate(h) if x in ('ani','identity'))
        ri=next((i for i,x in enumerate(h) if x.startswith('ref')),0)
        qi=next((i for i,x in enumerate(h) if x.startswith('query')),1)
        accepted=0;unmapped=[]
        for row in rows[1:]:
            if len(row)<=max(ai,ri,qi):continue
            try:ani=float(row[ai])
            except ValueError:continue
            if ani<99.5:continue
            a=lookup.get(norm(row[ri]));b=lookup.get(norm(row[qi]))
            if not a or not b:
                unmapped.append((row[ri],row[qi]));continue
            uf.join(index[a],index[b]);accepted+=1
        if unmapped:raise RuntimeError('ANI names not mapped: '+repr(unmapped[:4]))
        keys=['ANI995_'+records[uf.root(i)]['id'] for i in range(len(records))]
        atomic_json(old_lock,{'digest':current_input,'skani_result_sha256':sha(path)})
        log('[ANI] >=99.5% edges:',accepted,'components',len(set(keys)))
    # Never allow exact sequence-duplicates to land in separate groups.
    for i,r in enumerate(records):
        for j,q in enumerate(records[:i]):
            if q['genome_sha']==r['genome_sha'] and keys[i]!=keys[j]:
                raise RuntimeError('Identical genome assigned to two groups')
    return keys,method,{'group_count':len(set(keys)),'method':method,
                        'skani_sha256':sha(path) if path.exists() else None}

def make_folds(records,groups,out,cohort,method,provenance):
    folds={};allrows=[]
    for task in ('acid','bile'):
        inds=np.array([i for i,r in enumerate(records) if r[task] is not None],dtype=int)
        yy=np.array([records[i][task] for i in inds],dtype=int)
        gg=np.array([groups[i] for i in inds],dtype=str)
        if min(Counter(yy).values())<5 or len(set(gg))<5:
            raise RuntimeError('Not enough positive/negative labels or independent groups for '+task)
        sg=StratifiedGroupKFold(n_splits=5,shuffle=True,random_state=SEED)
        ff=[];seen=set()
        for fold,(tr,te) in enumerate(sg.split(inds,yy,gg),1):
            a=inds[tr];b=inds[te]
            if len(set(gg[tr]) & set(gg[te])):raise RuntimeError('GROUP LEAKAGE')
            if len(np.unique(yy[tr]))!=2 or len(np.unique(yy[te]))!=2:
                raise RuntimeError('A validation fold has only one class: '+task+' fold '+str(fold))
            if seen & set(b):raise RuntimeError('Repeated outer test index')
            seen.update(b.tolist());ff.append((a,b))
            for ix in b:
                allrows.append({'Task':task,'Fold':fold,'Strain_ID':records[ix]['id'],
                    'True_Label':records[ix][task],'ANI_Group':groups[ix],
                    'Group_Protocol':method,'Cohort':cohort['cohort_digest']})
        if seen!=set(inds.tolist()):raise RuntimeError('Incomplete OOF for '+task)
        folds[task]=(inds,ff)
    write_csv(out/'00_Frozen_ANI995_Folds.csv',allrows,list(allrows[0]))
    info={'seed':SEED,'scheme':'5-fold StratifiedGroupKFold by task',
        'ANI_method':method,'ANI':provenance,'cohort_digest':cohort['cohort_digest'],
        'folds_sha256':sha(out/'00_Frozen_ANI995_Folds.csv'),
        'independent_test_set':False}
    atomic_json(out/'00_Fold_Provenance.json',info)
    return folds,info


def fasta_chunks(path):
    op=gzip.open if str(path).lower().endswith('.gz') else open
    with op(path,'rt',encoding='ascii',errors='replace') as f:
        buff=[]
        for line in f:
            line=line.strip().upper()
            if not line:continue
            if line.startswith('>'):
                if buff:yield ''.join(buff);buff=[]
            else:buff.append(line)
        if buff:yield ''.join(buff)

def sampled_windows(path,nwindows,bp):
    seq='N'.join(fasta_chunks(path))
    if len(seq)<bp:yield seq;return
    starts=np.linspace(0,len(seq)-bp,num=nwindows,dtype=np.int64)
    for st in starts:yield seq[int(st):int(st)+bp]

def window_kmer(window,k,bins):
    """Orientation-invariant rolling hashed k-mers (specified, not exact count vectors)."""
    b=np.frombuffer(window.encode('ascii','replace'),dtype=np.uint8)
    lut=np.full(256,255,dtype=np.uint8)
    for x,v in ((65,0),(67,1),(71,2),(84,3)):lut[x]=v
    z=lut[b];n=len(z)-k+1
    if n<=0:return np.zeros(bins,dtype=np.float32)
    code=np.zeros(n,dtype=np.uint32);rc=np.zeros(n,dtype=np.uint32)
    valid=np.ones(n,dtype=bool)
    for j in range(k):
        s=z[j:j+n];valid &= (s<4)
        code=((code<<2)|(s.astype(np.uint32)&3))
        rc |= ((3-(s.astype(np.uint32)&3))<<(2*j))
    v=np.minimum(code[valid],rc[valid]).astype(np.uint64)
    # Multiplicative avalanche mixes every nucleotide, not just low k-mer bits.
    v^=v>>np.uint64(16);v*=np.uint64(0x7feb352d)
    v^=v>>np.uint64(15);v*=np.uint64(0x846ca68b)
    v^=v>>np.uint64(16)
    counts=np.bincount(np.asarray(v % bins,dtype=np.int64),minlength=bins)
    return counts.astype(np.float32)

def kmer_features(records,out,args):
    base=out/'cache'/'kmer';base.mkdir(parents=True,exist_ok=True)
    mats={f'{k}mer':[] for k in range(4,11)}
    for j,r in enumerate(records,1):
        key=digest([r['genome_sha'],args.windows,args.window_bp,args.kmer_bins,'canonical_hashed_v1'])[:24]
        p=base/(key+'.npz')
        got=None
        if p.exists():
            try:
                with np.load(p,allow_pickle=False) as z:
                    if z['genome_sha'].item()==r['genome_sha'] and all(f'k{k}' in z for k in range(4,11)):
                        got={f'{k}mer':z[f'k{k}'].astype(np.float32) for k in range(4,11)}
            except Exception:got=None
        if got is None:
            counts={f'{k}mer':np.zeros(args.kmer_bins,dtype=np.float32) for k in range(4,11)}
            for win in sampled_windows(r['fasta'],args.windows,args.window_bp):
                for k in range(4,11):counts[f'{k}mer']+=window_kmer(win,k,args.kmer_bins)
            # Normalize per k to frequency then log1p scaled for stability.
            got={k:np.log1p(1000*v/max(1.0,float(v.sum()))).astype(np.float32)
                 for k,v in counts.items()}
            tmp=p.with_suffix('.tmp.npz')
            np.savez_compressed(tmp,genome_sha=r['genome_sha'],**{f'k{k}':got[f'{k}mer'] for k in range(4,11)})
            os.replace(tmp,p)
        for k in mats:mats[k].append(got[k])
        if j%32==0:log('[KMER]',j,'/256')
    return {k:np.stack(v) for k,v in mats.items()}


def load_npz_matrix(path,records):
    with np.load(path,allow_pickle=False) as z:
        ik=next((v for v in ('ids','strain_ids','Strain_ID') if v in z.files),None)
        ek=next((v for v in ('embeddings','features','X') if v in z.files),None)
        hk=next((v for v in ('genome_sha256','genome_hashes','genome_sha') if v in z.files),None)
        if not ik or not ek or not hk:raise RuntimeError('NPZ requires ids, embeddings, genome_sha256')
        ids=[str(x) for x in z[ik].tolist()];arr=np.asarray(z[ek],dtype=np.float32)
        hs=[str(x) for x in z[hk].tolist()]
        if len(ids)!=len(set(ids)) or arr.ndim!=2 or len(ids)!=len(hs) or arr.shape[0]!=len(ids):
            raise RuntimeError('Malformed encoder NPZ')
        ix={x:i for i,x in enumerate(ids)}
        if any(r['id'] not in ix or hs[ix[r['id']]]!=r['genome_sha'] for r in records):
            raise RuntimeError('Unmatched genome SHA256 or Strain_ID in encoder NPZ')
        mat=arr[[ix[r['id']] for r in records]]
        if not np.isfinite(mat).all():raise RuntimeError('Nonfinite embeddings')
        return mat

def legacy_per_strain_cache(name,records,roots,args):
    tag=f'w{args.windows}_b{args.window_bp}_mean_last_v1'
    files=[]
    for rt in roots:
        p=rt/'Stage03_CombinationSearch'/'cache'/'lm_embeddings'/name
        if p.is_dir():files.extend(p.glob('*_'+tag+'.npz'))
    found={}
    for p in files:
        try:
            with np.load(p,allow_pickle=False) as z:
                rid=str(z['id'].item());sig=str(z['signature'].item())
                if rid in found:continue
                found[rid]=(p,sig)
        except Exception:continue
    out=[]
    for r in records:
        if r['id'] not in found:return None
        p,sig=found[r['id']]
        expected=f'{r["genome_size"]}:{r["genome_mtime_ns"]}:{tag}'
        if sig!=expected:return None
        with np.load(p,allow_pickle=False) as z:out.append(np.asarray(z['embedding'],dtype=np.float32))
    arr=np.stack(out)
    return arr if arr.ndim==2 and np.isfinite(arr).all() else None

def load_encoders(records,root,out,args):
    supplied=out/'feature_input';supplied.mkdir(parents=True,exist_ok=True)
    older=Path('/root/autodl-tmp/iLAB-G2P')
    roots=[root]+([older] if older.exists() and older!=root else [])
    outm={};availability={}
    for name in ENCODERS:
        errors=[];mat=None;origin=None
        for rt in [supplied,root/'feature_cache']:
            p=rt/(name+'.npz')
            if p.exists():
                try:mat=load_npz_matrix(p,records);origin=str(p);break
                except Exception as e:errors.append(str(p)+': '+str(e))
        if mat is None:
            try:mat=legacy_per_strain_cache(name,records,roots,args);origin='validated_legacy_per_strain_npz'
            except Exception as e:errors.append('legacy: '+str(e))
        if mat is None and args.extract_encoders:
            # Call the exact original official encoder implementation, if available.
            script=next((rt/'stage03_combinatorial_search.py' for rt in roots
                         if (rt/'stage03_combinatorial_search.py').exists()),None)
            if script is not None:
                try:
                    spec=importlib.util.spec_from_file_location('stage03_base_256',str(script))
                    mod=importlib.util.module_from_spec(spec);spec.loader.exec_module(mod)
                    oldout=root/'Stage03_CombinationSearch';oldout.mkdir(exist_ok=True)
                    rr=[{'id':r['id'],'fasta':r['fasta'],'species':r['species'],
                         'acid':r['acid'],'bile':r['bile']} for r in records]
                    # Official JEPA implementation is not interchangeable with HuggingFace AutoModel.
                    candidate=mod.extract_lm(name,rr,root,oldout,args)
                    if candidate is not None:
                        mat=np.asarray(candidate,dtype=np.float32);origin='original_stage03_encoder_'+str(script)
                except Exception as e:errors.append('official_extraction: '+repr(e))
            else:errors.append('stage03_combinatorial_search.py not found')
        if mat is not None and mat.ndim==2 and mat.shape[0]==256 and np.isfinite(mat).all():
            outm[name]=np.ascontiguousarray(mat,dtype=np.float32)
            availability[name]={'status':'READY','shape':list(mat.shape),'origin':origin}
            log('[ENCODER READY]',name,mat.shape,origin)
        else:
            availability[name]={'status':'UNAVAILABLE','reasons':errors,
                                'required':'authentic feature_input/<name>.npz with ids, embeddings, genome_sha256'}
            log('[ENCODER MISSING]',name,errors[:1])
    atomic_json(out/'00_Encoder_Availability.json',{'encoders':availability,'five_encoder_complete':len(outm)==5})
    return outm,availability

def transform(blocks,train,test,ytrain,method):
    xparts=[];yparts=[]
    # Each block is selected using TRAIN labels only, then normalized using TRAIN only.
    for mat in blocks:
        a=np.asarray(mat[train],dtype=np.float32);b=np.asarray(mat[test],dtype=np.float32)
        yc=ytrain.astype(np.float32)-float(ytrain.mean())
        mu=a.mean(axis=0,dtype=np.float64).astype(np.float32)
        var=np.maximum(np.mean(a*a,axis=0)-mu*mu,0)
        cov=yc @ a
        strength=(cov*cov)/(np.maximum(var,1e-16)*max(float(yc@yc),1e-16))
        strength[~np.isfinite(strength)]=0
        nz=np.flatnonzero(var>1e-14)
        if method=='concat_z':chosen=nz
        else:
            cnt=256 if method in ('block256_z','select128') else 128
            if len(nz)>cnt:
                ksel=np.argpartition(-strength[nz],cnt-1)[:cnt]
                chosen=np.sort(nz[ksel])
            else:chosen=nz
        if not len(chosen):continue
        aa=a[:,chosen];bb=b[:,chosen]
        if method=='block128_l2':
            n=Normalizer();aa=n.fit_transform(aa);bb=n.transform(bb)
        else:
            s=StandardScaler();aa=s.fit_transform(aa);bb=s.transform(bb)
            aa=np.clip(aa,-10,10);bb=np.clip(bb,-10,10)
        xparts.append(np.asarray(aa,dtype=np.float32));yparts.append(np.asarray(bb,dtype=np.float32))
    if not xparts:raise RuntimeError('All feature blocks had zero variance on training fold')
    X=np.concatenate(xparts,axis=1);Y=np.concatenate(yparts,axis=1)
    if method=='select128' and X.shape[1]>128:
        yc=np.asarray(ytrain,dtype=np.float32)-float(np.mean(ytrain))
        strength=np.abs(yc @ X)
        chosen=np.sort(np.argpartition(-strength,127)[:128])
        X=X[:,chosen];Y=Y[:,chosen]
    return X,Y

def available_clfs():
    ready=[];missing={}
    for n in CLASSIFIERS:
        try:
            if n=='XGBoost':import xgboost
            if n=='LightGBM':import lightgbm
            if n=='CatBoost':import catboost
            ready.append(n)
        except ImportError as e:missing[n]=str(e)
    return ready,missing

def classifier(name):
    if name=='LR_L2':return LogisticRegression(C=1,solver='liblinear',max_iter=1000,random_state=SEED)
    if name=='LR_L1':return LogisticRegression(C=0.3,penalty='l1',solver='liblinear',max_iter=1000,random_state=SEED)
    if name=='SVM_RBF':return SVC(C=1,kernel='rbf',probability=True,random_state=SEED,cache_size=300)
    if name=='RF':return RandomForestClassifier(n_estimators=160,min_samples_leaf=2,n_jobs=1,random_state=SEED)
    if name=='ExtraTrees':return ExtraTreesClassifier(n_estimators=160,min_samples_leaf=2,n_jobs=1,random_state=SEED)
    if name=='HistGB':return HistGradientBoostingClassifier(max_iter=100,max_leaf_nodes=15,l2_regularization=1,random_state=SEED)
    if name=='GradientBoosting':return GradientBoostingClassifier(n_estimators=100,max_depth=2,random_state=SEED)
    if name=='XGBoost':
        from xgboost import XGBClassifier
        return XGBClassifier(n_estimators=120,max_depth=3,learning_rate=.06,subsample=.9,colsample_bytree=.9,
                             eval_metric='logloss',n_jobs=1,random_state=SEED,tree_method='hist')
    if name=='LightGBM':
        from lightgbm import LGBMClassifier
        return LGBMClassifier(n_estimators=120,num_leaves=9,learning_rate=.05,
                    min_child_samples=10,n_jobs=1,verbosity=-1,random_state=SEED)
    if name=='CatBoost':
        from catboost import CatBoostClassifier
        return CatBoostClassifier(iterations=120,depth=4,learning_rate=.06,loss_function='Logloss',
                                   thread_count=1,verbose=False,random_seed=SEED)
    raise KeyError(name)

def metrics(y,proba,ypred):
    y=np.asarray(y,dtype=int);p=np.asarray(proba,dtype=float);pred=np.asarray(ypred,dtype=int)
    cm=confusion_matrix(y,pred,labels=[0,1]);tn,fp,fn,tp=map(int,cm.ravel())
    roc=roc_auc_score(y,p) if len(np.unique(y))==2 else float('nan')
    ap=average_precision_score(y,p) if len(np.unique(y))==2 else float('nan')
    return {'N':len(y),'Positive':int(y.sum()),'Negative':int(len(y)-y.sum()),
        'ROC_AUC':float(roc),'PR_AUC':float(ap),'MCC':float(matthews_corrcoef(y,pred)),
        'Balanced_Accuracy':float(balanced_accuracy_score(y,pred)),
        'Accuracy':float(accuracy_score(y,pred)),'Precision':float(precision_score(y,pred,zero_division=0)),
        'Recall':float(recall_score(y,pred,zero_division=0)),
        'F1':float(f1_score(y,pred,zero_division=0)),
        'Specificity':float(tn/max(1,tn+fp)),'TP':tp,'TN':tn,'FP':fp,'FN':fn,
        'Selection_Score':float(.6*ap+.4*matthews_corrcoef(y,pred)) if np.isfinite(ap) else float('nan')}

def combo_meta(task,route,up,mid,clf,cohort,foldsha):
    key={'v':VERSION,'cohort':cohort,'foldsha':foldsha,'task':task,'route':route,
         'up':list(up),'mid':mid,'clf':clf,'sklearn':sklearn.__version__,
         'feature_source_sha256':SOURCE_SHA256,
         'feature_sha256':{name:FEATURE_HASHES[name] for name in up}}
    cid=digest(key)[:20];return cid,key

def evaluate(job,records,folds,features,groups,meta,out):
    task,route,up,mid,clfname=job
    cid,key=combo_meta(task,route,up,mid,clfname,meta['cohort_digest'],meta['folds_sha256'])
    folder=out/'models'/task;folder.mkdir(parents=True,exist_ok=True)
    path=folder/(cid+'.npz');info_path=folder/(cid+'.json')
    if path.exists() and info_path.exists():
        try:
            old=json.loads(info_path.read_text())
            if old.get('key')==key:
                with np.load(path,allow_pickle=False) as z:
                    if int(z['n'])==len(folds[task][0]) and len(z['score'])==int(z['n']) and np.all(np.isfinite(z['score'])):
                        return {'status':'CACHED','id':cid,'task':task,'route':route,'up':up,'mid':mid,'clf':clfname,
                                'path':str(path),'info':str(info_path)}
        except Exception:pass
    # Use fold-local transformations. NO calibration, feature selection or fitting on held-out rows.
    idx,ff=folds[task]
    score=np.full(len(records),np.nan,dtype=np.float64)
    pred=np.full(len(records),-1,dtype=np.int8)
    foldid=np.zeros(len(records),dtype=np.int8)
    dimensions=[]
    for k,(tr,te) in enumerate(ff,1):
        ytr=np.array([records[i][task] for i in tr],dtype=int)
        a,b=transform([features[x] for x in up],tr,te,ytr,mid)
        model=classifier(clfname)
        with warnings.catch_warnings():
            warnings.simplefilter('ignore',category=FutureWarning)
            model.fit(a,ytr)
        prob=model.predict_proba(b)[:,1]
        if not np.all(np.isfinite(prob)):raise RuntimeError('Nonfinite test scores')
        score[te]=prob;pred[te]=(prob>=.5).astype(np.int8);foldid[te]=k
        dimensions.append(int(a.shape[1]))
    if np.isnan(score[idx]).any() or np.any(foldid[idx]==0) or np.any(pred[idx]<0):
        raise RuntimeError('Incomplete full five-fold predictions')
    if int(np.isfinite(score).sum())!=len(idx):raise RuntimeError('Predictions leaked into unlabeled task rows')
    temp=path.with_suffix('.tmp.npz')
    np.savez_compressed(temp,score=score,pred=pred,fold=foldid,n=np.int64(len(idx)))
    os.replace(temp,path)
    info={'key':key,'upstream':'+'.join(up),'middle':mid,'classifier':clfname,
          'effective_dim_max':max(dimensions),'effective_dim_mean':float(np.mean(dimensions)),
          'fold_dims':dimensions,'cohort':'256','complete_five_fold_OOF':True}
    atomic_json(info_path,info)
    return {'status':'PASS','id':cid,'task':task,'route':route,'up':up,'mid':mid,'clf':clfname,
            'path':str(path),'info':str(info_path)}

def merge_verified_existing(completed,out,meta):
    """Include previous VALID 256-model artifacts, never another cohort or code protocol."""
    seen={x['id']:x for x in completed if x.get('status') in ('PASS','CACHED')}
    for jp in (out/'models').glob('*/*.json'):
        if jp.stem in seen:continue
        try:
            info=json.loads(jp.read_text(encoding='utf-8'));key=info.get('key',{})
            if not info.get('complete_five_fold_OOF'):continue
            if key.get('v')!=VERSION or key.get('cohort')!=meta['cohort_digest']:continue
            if key.get('foldsha')!=meta['folds_sha256'] or key.get('feature_source_sha256')!=SOURCE_SHA256:continue
            up=tuple(key['up'])
            if any(u not in FEATURE_HASHES or key['feature_sha256'].get(u)!=FEATURE_HASHES[u] for u in up):continue
            npz=jp.with_suffix('.npz')
            if not npz.exists():continue
            row={'status':'CACHED','id':jp.stem,'task':key['task'],'route':key['route'],
                 'up':up,'mid':key['mid'],'clf':key['clf'],'path':str(npz),'info':str(jp)}
            cid,_=combo_meta(row['task'],row['route'],up,row['mid'],row['clf'],
                             meta['cohort_digest'],meta['folds_sha256'])
            if cid==jp.stem:seen[cid]=row
        except Exception:continue
    return list(seen.values())

def info_missing(av,missing):
    return bool(missing) or any(av[n]['status']!='READY' for n in ENCODERS)

