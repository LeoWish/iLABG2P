def build_plan(lm,kmer,mode):
    a=[];b=[]
    if mode!='kmer':
        names=list(lm)
        # Up to 3-way interactions plus the full five encoders if available.
        for n in range(1,min(3,len(names))+1):a+=list(itertools.combinations(names,n))
        if len(names)>=4:a.append(tuple(names))
    if mode!='encoder':
        singles=[(f'{k}mer',) for k in range(4,11)]
        pairs=list(itertools.combinations([f'{k}mer' for k in range(4,11)],2))
        triples=[tuple(f'{k+j}mer' for j in range(3)) for k in range(4,9)]
        b=singles+pairs+triples+[tuple(f'{k}mer' for k in range(4,11))]
    return list(dict.fromkeys(a)),list(dict.fromkeys(b))

def run_jobs(jobs,records,folds,features,groups,meta,out,args,results,failures):
    if not jobs:return
    log('[START]',len(jobs),'configurations; complete FULL5 OOF')
    with ThreadPoolExecutor(max_workers=args.workers) as pool:
        futs={pool.submit(evaluate,j,records,folds,features,groups,meta,out):j for j in jobs}
        for n,fut in enumerate(as_completed(futs),1):
            try:results.append(fut.result())
            except Exception as e:
                job=futs[fut];failures.append({'job':str(job),'reason':repr(e),
                                               'traceback':traceback.format_exc(limit=5)})
                if len(failures)<=6:log('[MODEL FAILED]',job,repr(e)[:250])
            if n%50==0 or n==len(jobs):
                log('[PROGRESS]',n,'/',len(jobs),'pass',len(results),'fail',len(failures))
                write_csv(out/'99_Model_Failures.csv',failures,['job','reason','traceback'])

